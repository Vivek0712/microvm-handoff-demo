{
  "image": "demo-agent",
  "baseline_mib": 512,
  "policy": {"budget_s": 120, "heartbeat_timeout_s": 30, "slack_s": 60, "max_concurrency": 4,
             "max_vm_seconds": 3000, "approval_usd": 0.015},
  "scenarios": [
    {"id": "single", "orchestrators": ["stepfunctions", "durable"],
     "task": {"steps": ["uname -m", "python3 -c 'print(2+2)'", "sleep 2"]},
     "expected": "SUCCEEDED; passed true; 3 steps; VM terminated by the orchestrator"},
    {"id": "parallel", "orchestrators": ["stepfunctions", "durable"],
     "task": {"steps": ["sleep 3", "sleep 3", "sleep 3", "sleep 3"], "parallel": true, "max_parallel": 4},
     "compare_with": {"steps": ["sleep 3", "sleep 3", "sleep 3", "sleep 3"]},
     "expected": "parallel wall time about 3 s inside the VM against about 12 s sequential"},
    {"id": "retryable-fail", "orchestrators": ["stepfunctions", "durable"],
     "task": {"steps": ["uname -m"], "fail_after_s": 2},
     "expected": "sfn: Lease -> Reap -> TerminateStale -> Failed with the typed Injected error; durable: two attempts, status failed, retryable true, attempt 1"},
    {"id": "hang", "orchestrators": ["stepfunctions", "durable"], "budget_s": 60,
     "task": {"steps": ["uname -m"], "hang_s": 400},
     "expected": "budget timeout while heartbeats continue; the orchestrator terminates the VM; sfn Failed via Reap, durable status timeout"},
    {"id": "fanout-4", "orchestrators": ["stepfunctions", "durable"], "shards": 4,
     "shard": {"steps": ["uname -m", "sleep 2"]},
     "expected": "plan concurrency 4, 1 wave; 4 results"},
    {"id": "fanout-8", "orchestrators": ["stepfunctions", "durable"], "shards": 8,
     "shard": {"steps": ["uname -m", "sleep 2"]},
     "expected": "plan concurrency 4, 2 waves; 8 results"},
    {"id": "fanout-refused", "orchestrators": ["stepfunctions", "durable"], "shards": 40,
     "shard": {"steps": ["uname -m", "sleep 2"]},
     "expected": "worst case 7200 VM-s exceeds max_vm_seconds 3000: refused before any RunMicrovm"},
    {"id": "fanout-approved", "orchestrators": ["stepfunctions", "durable"], "shards": 12, "approve": true,
     "shard": {"steps": ["uname -m", "sleep 2"]},
     "expected": "worst case $0.0189 above approval_usd 0.015 (sfn: 12 shards above ApproveAboveShards 8): gate waits, approver says yes, 12 results in 3 waves"},
    {"id": "fanout-denied", "orchestrators": ["stepfunctions", "durable"], "shards": 12, "approve": false,
     "shard": {"steps": ["uname -m", "sleep 2"]},
     "expected": "gate waits, approver says no, nothing launched"},
    {"id": "cli-none", "orchestrators": ["cli"],
     "task": {"steps": ["uname -m", "python3 -c 'print(2+2)'", "sleep 2", "echo done"]},
     "expected": "mvm lease run --kind none --wait then mvm watch; done with 0 heartbeats; terminated by the CLI"}
  ]
}
